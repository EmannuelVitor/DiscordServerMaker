# Token do bot (Discord Developer Portal > Applications > Bot > Reset Token)
DISCORD_TOKEN=

# Chave da API da Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Modelo e esforço de raciocínio (low | medium | high | xhigh | max)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# IDs de cargos (separados por vírgula) que podem usar o bot além de quem
# tem a permissão "Gerenciar Servidor". Deixe vazio para só admins.
ALLOWED_ROLE_IDS=

# Pede confirmação (botões) antes de ações destrutivas: excluir canais/cargos,
# expulsar, banir, apagar mensagens.
REQUIRE_CONFIRMATION=true
CONFIRM_TIMEOUT_SECONDS=60

# Limites da conversa
MAX_TOOL_ROUNDS=25
MAX_HISTORY_MESSAGES=80

# Opcional: ID de um servidor para sincronizar os comandos de barra na hora
# (sem isso a sincronização global pode levar alguns minutos).
DEV_GUILD_ID=

# Modo Claude Code (python -m bot.cli): servidor padrão se o bot estiver em vários.
DISCORD_GUILD_ID=
